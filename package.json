{
  "name": "dev-test-wade-pate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "prisma generate && next build --turbo",
    "build:webpack": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "./scripts/reset-and-seed.sh production",
    "db:studio": "prisma studio",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:e2e": "NODE_ENV='test' playwright test",
    "docker:build-dev": "docker compose build",
    "docker:run-dev": "docker compose up",
    "docker:build-prod": "docker compose -f docker-compose.prod.yml build",
    "docker:run-prod": "docker compose -f docker-compose.prod.yml up",
    "docker:cleanup": "docker system prune -f && docker volume prune -f",
    "docker:optimize": "bash scripts/docker-optimize.sh",
    "analyze": "ANALYZE=true yarn build",
    "bundle-analyzer": "yarn add -D @next/bundle-analyzer && yarn analyze",
    "setup:fresh": "yarn install && yarn db:generate && yarn db:migrate && yarn db:seed",
    "setup:dev": "yarn db:generate && yarn db:seed",
    "build:check": "yarn type-check && yarn lint && yarn build && yarn test:e2e",
    "deploy:prod": "yarn build:check && vercel --prod",
    "docker:logs": "docker compose logs -f",
    "reset:all": "yarn docker:cleanup && rm -rf node_modules .next && yarn install && yarn setup:fresh",
    "clean:imports": "node scripts/clean-ui-imports.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.25.2",
    "@hookform/resolvers": "^5.1.1",
    "@linear/sdk": "^53.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@sentry/nextjs": "^9.41.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/multer": "^2.0.0",
    "@vercel/blob": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "encoding": "^0.1.13",
    "lucide-react": "^0.525.0",
    "multer": "^2.0.1",
    "next": "^15.4.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.4",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.60.0",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.5",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.1",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "cspell": "^9.1.5",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.1"
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": "22.x"
  }
}
